# Copy to .env and adjust. All values have safe defaults in app/config.py.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Storage
STORAGE_DIR=storage
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=10

# Upload limits
MAX_FILE_MB=50
MAX_PDF_PAGES=200
MAX_WORDS=100000
MIN_WORDS=20
SCANNED_PAGE_MIN_CHARS=30
SCANNED_PAGE_RATIO=0.5
# Uploads per client IP per rolling hour (D30); 0 disables
UPLOADS_PER_IP_PER_HOUR=10

# Jobs
MAX_ACTIVE_JOBS=1
MAX_QUEUED_JOBS=3
EXPIRED_STUB_MINUTES=60
MEMORY_LOG_INTERVAL_SECONDS=30

# TTS
TTS_PRIMARY=edge
# piper = edge-tts with local Piper fallback; none = edge-tts only (the deployed server, D26; set TTS_MAX_RETRIES=5)
TTS_FALLBACK=piper
EDGE_VOICE=en-US-AriaNeural
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_DISABLE_ARENA=true
PIPER_MAX_CHARS=300
TTS_CONCURRENCY=4
TTS_CHUNK_MAX_CHARS=1500
TTS_MAX_RETRIES=3
TTS_FALLBACK_AFTER_CONSECUTIVE_FAILURES=5

# v2 character voices (SPEC §15). Groq key stays on the server only; never commit it.
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_REQUESTS_PER_MINUTE=25
LLM_MAX_REQUESTS_PER_DAY=800
MAX_CAST=8
