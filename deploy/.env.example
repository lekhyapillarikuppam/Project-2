# Copy to deploy/.env on the VM (bootstrap.sh does this) and set API_DOMAIN.
# All other app settings have defaults in backend/app/config.py (see backend/.env.example).

# The VM's Azure DNS name; Caddy requests the HTTPS certificate for it.
API_DOMAIN=<label>.centralindia.cloudapp.azure.com

# TTS (D26): edge-tts only, patient retries
TTS_FALLBACK=none
TTS_MAX_RETRIES=5
TTS_CONCURRENCY=4

# Comma-separated frontend origins; in production:
# CORS_ORIGINS=https://audiobook-generator-lekhya.vercel.app,https://project-2-eight-azure.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
APP_ENV=production

# Build the image with the Piper voices (only needed for TTS_FALLBACK=piper)
INCLUDE_PIPER=false
# Used only when INCLUDE_PIPER=true and TTS_FALLBACK=piper
PIPER_MODEL_PATH=/app/models/en_US-lessac-low.onnx
PIPER_DISABLE_ARENA=true
PIPER_MAX_CHARS=300

# v2 character voices (SPEC §15): leave GROQ_API_KEY empty to hide the option
GROQ_API_KEY=
# Model and method chosen by D39 (D40)
LLM_MODEL=qwen/qwen3.8-27b
ATTRIBUTION_METHOD=llm
# Groq limits on this key: 8,000 tokens/min overall, 1,000 completion tokens/min for the model (D42)
LLM_TOKENS_PER_MINUTE=7000
LLM_OUTPUT_TOKENS_PER_MINUTE=1000
LLM_MAX_REQUESTS_PER_DAY=800
MAX_CAST=8
