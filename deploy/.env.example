# Copy to deploy/.env on the VM (bootstrap.sh does this) and set API_DOMAIN.
# All other app settings have defaults in backend/app/config.py (see backend/.env.example).

# The VM's Azure DNS name; Caddy requests the HTTPS certificate for it.
API_DOMAIN=<label>.centralindia.cloudapp.azure.com

# TTS (D26): edge-tts only, patient retries
TTS_FALLBACK=none
TTS_MAX_RETRIES=5
TTS_CONCURRENCY=4

# Comma-separated frontend origins (the Vercel URL is added in Phase 5)
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
APP_ENV=production

# Build the image with the Piper voices (only needed for TTS_FALLBACK=piper)
INCLUDE_PIPER=false
# Used only when INCLUDE_PIPER=true and TTS_FALLBACK=piper
PIPER_MODEL_PATH=/app/models/en_US-lessac-low.onnx
PIPER_DISABLE_ARENA=true
PIPER_MAX_CHARS=300
